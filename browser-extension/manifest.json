{
  "manifest_version": 3,
  "name": "Cofre local", "version": "1.0.0",
  "description": "Consulta o cofre local e preenche a conta escolhida no login da aba aberta.",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "minimum_chrome_version": "106",
  "background": {"service_worker": "dist/service-worker.js", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
